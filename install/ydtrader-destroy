#!/bin/sh
# Fixed-target expiry helper. It intentionally produces no application audit output.
set -eu
umask 077

[ "$#" -eq 0 ] || exit 64
[ "$(id -u)" -eq 0 ] || exit 77

install_root=/opt/ydtrader
state_root=/var/lib/ydtrader
helper_root=/usr/local/libexec
public_key="$helper_root/ydtrader-public.pem"
manifest="$install_root/install_manifest.sha256"
signature="$install_root/install_manifest.sig"

fail_closed() {
    exit 1
}

[ -d "$install_root" ] || fail_closed
[ ! -L "$install_root" ] || fail_closed
[ "$(realpath -e -- "$install_root")" = "$install_root" ] || fail_closed
[ "$(stat -c %u -- "$install_root")" -eq 0 ] || fail_closed
[ -f "$install_root/.ydtrader-install-marker" ] || fail_closed
[ "$(cat -- "$install_root/.ydtrader-install-marker")" = "ydtrader-install-v1" ] || fail_closed
[ -f "$manifest" ] && [ ! -L "$manifest" ] || fail_closed
[ -f "$signature" ] && [ ! -L "$signature" ] || fail_closed
[ -f "$public_key" ] && [ ! -L "$public_key" ] || fail_closed

openssl pkeyutl -verify -pubin -inkey "$public_key" -rawin \
    -in "$manifest" -sigfile "$signature" >/dev/null 2>&1 || fail_closed
(cd "$install_root" && sha256sum --strict -c install_manifest.sha256 >/dev/null 2>&1) || fail_closed

[ -d "$state_root" ] || fail_closed
[ ! -L "$state_root" ] || fail_closed
[ "$(realpath -e -- "$state_root")" = "$state_root" ] || fail_closed
[ "$(stat -c %u -- "$state_root")" -eq 0 ] || fail_closed
[ -f "$state_root/.ydtrader-state-marker" ] || fail_closed
[ "$(cat -- "$state_root/.ydtrader-state-marker")" = "ydtrader-state-v1" ] || fail_closed

for proc_exe in /proc/[0-9]*/exe; do
    [ -e "$proc_exe" ] || continue
    actual_exe=$(readlink -f -- "$proc_exe" 2>/dev/null || true)
    case "$actual_exe" in
        "$install_root"/*)
            pid=${proc_exe#/proc/}
            pid=${pid%/exe}
            kill -TERM "$pid" 2>/dev/null || true
            ;;
    esac
done
sleep 2
for proc_exe in /proc/[0-9]*/exe; do
    [ -e "$proc_exe" ] || continue
    actual_exe=$(readlink -f -- "$proc_exe" 2>/dev/null || true)
    case "$actual_exe" in
        "$install_root"/*)
            pid=${proc_exe#/proc/}
            pid=${pid%/exe}
            kill -KILL "$pid" 2>/dev/null || true
            ;;
    esac
done

expired_root="/opt/.ydtrader-expired-$(date -u +%Y%m%dT%H%M%SZ)-$$"
case "$expired_root" in
    /opt/.ydtrader-expired-*) ;;
    *) fail_closed ;;
esac
[ ! -e "$expired_root" ] || fail_closed
mv -- "$install_root" "$expired_root"
rm -rf --one-file-system -- "$expired_root"
rm -rf --one-file-system -- "$state_root"

systemctl disable ydtrader-expiry.timer >/dev/null 2>&1 || true
rm -f -- /etc/systemd/system/ydtrader-expiry.timer \
    /etc/systemd/system/ydtrader-expiry.service
systemctl daemon-reload >/dev/null 2>&1 || true
rm -f -- "$public_key"

# The running inode remains available until this process exits.
rm -f -- "$helper_root/ydtrader-destroy"
exit 0
