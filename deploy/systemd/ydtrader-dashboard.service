[Unit]
Description=YDTrader market-data dashboard
After=network-online.target
Wants=network-online.target
PartOf=ydtrader-stack.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/usr/bin/bash @PROJECT_ROOT@/scripts/run_dashboard_service.sh
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ydtrader-dashboard

[Install]
WantedBy=ydtrader-stack.target
